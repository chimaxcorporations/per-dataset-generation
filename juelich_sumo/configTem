<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

  <input>
    <net-file value="net/juelich.net.xml"/>
    <route-files value="routes/juelich.rou.xml"/>
    <!-- Optional: detectors, TLS programs, polygon types, etc. -->
    <additional-files value="additional/juelich.add.xml"/>
  </input>

  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="0.1"/>
  </time>

  <report>
    <no-step-log value="true"/>
    <duration-log.statistics value="true"/>
  </report>

  <output>
    <!-- Useful for analysis / dataset building -->
    <tripinfo-output value="output/traces/tripinfo.xml"/>
    <fcd-output value="output/traces/fcd.xml"/>
    <summary-output value="output/traces/summary.xml"/>
  </output>

</configuration>
